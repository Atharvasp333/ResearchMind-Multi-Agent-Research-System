# ==============================================================================
# Multi-Agent Research System - Environment Configuration
# ==============================================================================
# Duplicate this file as '.env' and fill in your actual API keys.
#
# On Linux/macOS: cp .env.example .env
# On Windows PowerShell: Copy-Item .env.example .env
# ==============================================================================

# Groq API Key (Required for LLM inference — agents, writer chain & critic chain)
# Models used: openai/gpt-oss-120b (default), llama-3.1-8b-instant (fast alternative)
# Get your FREE key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Required for the web search tool)
# Get your free key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
